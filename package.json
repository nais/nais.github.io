{
	"name": "nais-io",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"build-rss": "node build-rss.js",
		"dev": "vite dev",
		"build": "vite build && node build-rss.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/eslint": "9.6.1",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"mdsvex": "0.12.8",
		"mdsvex-relative-images": "2.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4"
	},
	"dependencies": {
		"@nais/ds-svelte-community": "2.0.0-next.8",
		"date-fns": "4.4.0",
		"feed": "6.0.0",
		"parse-md": "3.0.3",
		"shiki": "4.5.0",
		"svelte-preprocess": "6.0.5",
		"unified": "11.0.5"
	}
}
